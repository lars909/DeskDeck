{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskDeck",
  "version": "1.0.0",
  "identifier": "de.deskdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskDeck",
        "width": 680,
        "height": 252,
        "minWidth": 600,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#080d17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}